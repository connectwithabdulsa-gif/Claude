# copy to .env and fill in. .env is gitignored. never commit real values.

# database (sqlite file, gitignored under data/)
ENGINE_DB=data/engine.db

# anthropic api (phase 4+). used for writing, QA and reply classification.
ANTHROPIC_API_KEY=

# spacemail (spaceship). settings from CLAUDE.md section 12.
# one cold sending mailbox on a SECONDARY domain. never the main gmail or main domain.
SPACEMAIL_USER=you@your-secondary-domain.com
SPACEMAIL_PASSWORD=
SPACEMAIL_IMAP_HOST=mail.spacemail.com
SPACEMAIL_IMAP_PORT=993
SPACEMAIL_SMTP_HOST=mail.spacemail.com
SPACEMAIL_SMTP_PORT=465
